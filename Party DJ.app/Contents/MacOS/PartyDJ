#!/bin/bash
# Party DJ for the Mac: double-click, pick the party, and the DJ page opens. No Terminal needed.
# It runs the same program as "python3 dj.py --config <party> --app" and stops it when you press
# Stop the party.
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin:$PATH"
TITLE="Party DJ"
say_box() {   # a message with one OK button
  osascript - "$1" "$TITLE" <<'OSA' >/dev/null 2>&1
on run argv
  activate
  display dialog (item 1 of argv) with title (item 2 of argv) buttons {"OK"} default button "OK" with icon note
end run
OSA
}

# 1. Find the party-dj folder: the one this app sits in, or the usual places.
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
DIR=""
for d in "$APP_DIR" "$HOME/party-dj" "$HOME/Downloads/party-dj-main" "$HOME/Desktop/party-dj-main" \
         "$HOME/Downloads/party-dj" "$HOME/Documents/party-dj" "$HOME/Documents/party-dj-main"; do
  if [ -f "$d/dj.py" ]; then DIR="$d"; break; fi
done
if [ -z "$DIR" ]; then
  DIR="$(osascript -e 'activate' -e 'POSIX path of (choose folder with prompt "Where is the party-dj folder (the one with dj.py in it)?")' 2>/dev/null)"
  DIR="${DIR%/}"
  [ -f "$DIR/dj.py" ] || { say_box "That folder doesn't have dj.py in it, so the DJ can't start."; exit 1; }
fi
cd "$DIR" || exit 1
mkdir -p .cache
LOG="$DIR/.cache/app.log"
PIDF="$DIR/.cache/app.pid"

# 2. Already playing? Then just offer the page or stop.
running() { [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }

party_on() {   # the window that stays up while the party plays
  local pid; pid="$(cat "$PIDF")"
  while kill -0 "$pid" 2>/dev/null; do
    osascript - "$TITLE" > "$DIR/.cache/app.answer" 2>/dev/null <<'OSA' &
on run argv
  activate
  set r to display dialog "🎉 The party is on!" & return & return & "The DJ page opens in your browser (the first time it can take a minute): press the big START button there." & return & return & "Keep this Mac plugged in, and leave this window and the browser open. When the night is over, press Stop the party." with title (item 1 of argv) buttons {"Stop the party", "Open the DJ page"} default button "Open the DJ page" with icon note
  return button returned of r
end run
OSA
    local osa=$!
    while kill -0 "$osa" 2>/dev/null; do
      if ! kill -0 "$pid" 2>/dev/null; then kill "$osa" 2>/dev/null; break; fi
      sleep 1
    done
    local ans; ans="$(cat "$DIR/.cache/app.answer" 2>/dev/null)"
    if [ "$ans" = "Stop the party" ]; then
      sure="$(osascript -e 'activate' -e 'button returned of (display dialog "Stop the music and end the party?" with title "Party DJ" buttons {"Keep playing", "Stop the party"} default button "Keep playing" with icon caution)' 2>/dev/null)"
      if [ "$sure" = "Stop the party" ]; then
        kill -INT "$pid" 2>/dev/null
        for i in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
        kill "$pid" 2>/dev/null; rm -f "$PIDF"
        if [ -f "$DIR/party_recap.html" ]; then
          again="$(osascript -e 'activate' -e 'button returned of (display dialog "The party is over. Thank you!" & return & return & "The party recap (every song that played) is saved." with title "Party DJ" buttons {"Close", "Open the recap"} default button "Close" with icon note)' 2>/dev/null)"
          [ "$again" = "Open the recap" ] && open "$DIR/party_recap.html"
        fi
        return 0
      fi
    elif [ "$ans" = "Open the DJ page" ]; then
      open "http://localhost:8765/"
    fi
  done
  # The DJ program stopped by itself: say why.
  rm -f "$PIDF"
  say_box "The DJ stopped unexpectedly. Double-click Party DJ to start it again: it picks up where it left off.

What it said last:
$(tail -n 6 "$LOG" 2>/dev/null)"
  return 1
}

if running; then party_on; exit $?; fi

# 3. First time on this Mac: set up Python's helpers (needs the internet, about a minute).
PY="$DIR/.venv/bin/python3"
if [ ! -x "$PY" ]; then
  osascript -e 'display notification "Getting the DJ ready for the first time. This takes a minute or two." with title "Party DJ"'
  if ! { /usr/bin/python3 -m venv "$DIR/.venv" && "$PY" -m pip install -q -r "$DIR/requirements.txt"; } > "$LOG" 2>&1; then
    say_box "The DJ couldn't get ready (is the Mac on the internet?). If it asks to install Apple's developer tools, say yes, then double-click Party DJ again.

$(tail -n 4 "$LOG")"
    rm -rf "$DIR/.venv"; exit 1
  fi
fi

# 4. Which party?
LIST="$("$PY" dj.py --list-parties 2>/dev/null)"
if [ -z "$LIST" ]; then
  say_box "No party is set up in this folder yet."; exit 1
fi
NAMES="$(printf '%s\n' "$LIST" | cut -f2)"
PICK="$(osascript - "$NAMES" <<'OSA' 2>/dev/null
on run argv
  set L to paragraphs of (item 1 of argv)
  activate
  set r to choose from list L with title "Party DJ" with prompt "Which party is it tonight?" default items {item 1 of L} OK button name "Start the party" cancel button name "Cancel"
  if r is false then return ""
  return item 1 of r
end run
OSA
)"
[ -z "$PICK" ] && exit 0
CONFIG="$(printf '%s\n' "$LIST" | awk -F'\t' -v n="$PICK" '$2 == n {print $1; exit}')"
[ -z "$CONFIG" ] && exit 1

# 5. Start the DJ. It opens the DJ page in the browser by itself once the songs are ready.
osascript -e 'display notification "Getting tonight'"'"'s songs ready. The DJ page opens in your browser in a moment." with title "Party DJ"'
: > "$LOG"
nohup "$PY" -u dj.py --config "$CONFIG" --app >> "$LOG" 2>&1 < /dev/null &
echo $! > "$PIDF"
caffeinate -dimsu -w "$(cat "$PIDF")" &   # the Mac doesn't sleep while the party plays
for i in $(seq 1 240); do   # wait for the page (up to 2 minutes)
  grep -q "The DJ page is open" "$LOG" 2>/dev/null && break
  kill -0 "$(cat "$PIDF")" 2>/dev/null || break
  sleep 0.5
done
party_on
